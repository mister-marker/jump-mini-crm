# Copy to .env in backend/. Never expose server keys in VITE_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
CRM_WEB_APP_URL=https://jump-mini-crm.vercel.app
# Optional: enable the bot by setting a separate random webhook secret (32–256 characters).
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-url-safe-secret
# Set only on Render; startup registers this URL with Telegram automatically.
# TELEGRAM_WEBHOOK_URL=https://jump-mini-crm.onrender.com/api/webhooks/telegram
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=replace-with-random-secret-at-least-32-bytes
# Demo value requested for the MVP. Change before connecting real systems.
WEBHOOK_SECRET=replace-with-external-webhook-secret
JWT_ISSUER=jump-crm
JWT_AUDIENCE=jump-crm-api
JWT_TTL_SECONDS=3600
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TELEGRAM_CLOCK_SKEW_SECONDS=30

# Enable only for the evaluator's demo database; grants access to that CRM's data.
PIN_LOGIN_ENABLED=true
BROWSER_PIN=2026
DEMO_MANAGER_ID=00000000-0000-4000-8000-000000000026
CORS_ORIGINS=["http://localhost:5173"]
